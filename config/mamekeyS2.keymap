            sensor-bindings = <&win_enc
            &vol_up_down
            >;
        };
        
          JIS_NUM {
            bindings = <
&kp LG(LS(S))  &kp LC(X)  &kp LC(LS(TAB))         &kp LC(TAB)              &kp LC(T)                                      &kp JP_PLUS        &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp MINUS
&kp LC(A)      &kp LC(C)  &kp LA(LEFT_ARROW)      &kp LA(RIGHT_ARROW)      &kp LC(V)  &kp LG(D)  &trans  &trans  &trans   &kp JP_ASTRK     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp JP_EQUAL
